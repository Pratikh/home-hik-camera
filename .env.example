# Copy to .env and fill in. Never commit .env.
# Existing HIKVISION_IP / HIKVISION_USERNAME / HIKVISION_PASSWORD are also accepted.

# Hikvision DVR on the home LAN. The app and MediaMTX talk to this host.
# The browser never receives these values.
DVR_HOST=192.168.1.100
DVR_HTTP_PORT=80
DVR_RTSP_PORT=554
DVR_USERNAME=admin
DVR_PASSWORD=CHANGE_ME

# Single-user login for this hub. Required. No default password is built in.
APP_USERNAME=
APP_PASSWORD=

# Required. At least 16 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Leave false for plain HTTP on a trusted home LAN so the session cookie still works.
# Set true only when the hub is served over HTTPS (for example through a tunnel).
COOKIE_SECURE=false

# Which peers may set forwarding headers (X-Forwarded-For / X-Forwarded-Proto /
# CF-Connecting-IP). Only list the local tunnel/proxy process that connects to
# the hub — NOT LAN clients. Empty (the default) means "never trust forwarding
# headers": the TCP peer address is used for rate limiting, audit logs and the
# Secure-cookie decision, so a direct client cannot spoof them.
#
# Tailscale Funnel or a cloudflared process running on this host:
#   TRUSTED_PROXY_CIDRS=127.0.0.1,::1
# A tunnel running as a container: use that container's fixed address/network
#   (for example 172.18.0.0/16), never a public range.
TRUSTED_PROXY_CIDRS=

# REQUIRED. MediaMTX rejects every read and every Control API call without this
# credential (the API is no longer anonymous; see the Phase 3 docs).
# Generate one with: openssl rand -base64 32
# Use a fresh value; never reuse a DVR, Telegram or session secret.
# After changing it, recreate MediaMTX so the container re-renders its config:
#   podman compose up -d --force-recreate mediamtx
# MEDIAMTX_ALLOW_ANONYMOUS=true is a local-development escape hatch only and
# must never be set in production.
MEDIAMTX_AUTH_USER=hub
MEDIAMTX_AUTH_PASSWORD=
# Dedicated read-only MediaMTX account used by the object-detection worker. It
# shares MEDIAMTX_AUTH_PASSWORD above but has read-only permission and is bound
# to the worker's compose address, so the worker can never use the Control API.
MEDIAMTX_WORKER_USER=worker
# Development only. MediaMTX refuses to start without a password unless this is
# explicitly true. Never set it in production.
# MEDIAMTX_ALLOW_ANONYMOUS=true

# URLs the Next.js server uses to reach MediaMTX.
# podman compose overrides these to the mediamtx service name.
# npm run dev on the host uses the published localhost ports.
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_WHEP_URL=http://127.0.0.1:8889
MEDIAMTX_HLS_URL=http://127.0.0.1:8888

# LAN address of this computer, advertised in WebRTC ICE candidates.
# Phones need this or they fall back to HLS. Comma-separate several addresses.
# Example: 192.168.0.25
# 127.0.0.1 is always added for the computer running the hub.
WEBRTC_ADDITIONAL_HOST=

# Labeled test pattern for UI work. Default off. Production stays off.
VIDEO_DEV_PLACEHOLDER=false

# Recording fixtures for playback UI work. Default off.
# Ignored when NODE_ENV=production, so a production process cannot show fake recordings.
PLAYBACK_DEV_MOCK=false

# How often the hub asks the DVR for new alarm-log events, in milliseconds.
EVENT_POLL_INTERVAL_MS=5000

# How old (seconds) a DVR event may be and still send a notification.
#
# After the hub has been offline, its first poll re-reads the DVR's alarm log so
# nothing is missing from the Events page. Those recovered events keep their
# ORIGINAL DVR timestamp, so without this limit a server that was down all
# afternoon would replay the afternoon's motion to Telegram on startup.
#
# Events older than this are still stored and visible on the Events page; they
# simply never notify. The check uses the DVR event timestamp, never the time
# the hub received or stored the row. Object-detection (person/vehicle) events
# are created from a live frame and are not affected by this setting.
#
# Default 120s comfortably covers the poll overlap plus processing. Set 0 to
# notify only for events stamped "now" (strictest), or raise it if you want
# alerts for slightly delayed DVR logs. Range: 0–86400.
DVR_NOTIFICATION_MAX_EVENT_AGE_SECONDS=120

# How long this hub keeps its own event rows. 0 means forever.
# This does not delete recordings on the DVR.
EVENT_RETENTION_DAYS=30

# How long audit-log rows are kept (logins, user/settings changes, IP/user-agent).
# 0 keeps them forever, which is not recommended for a household CCTV system.
# Detection tracks follow EVENT_RETENTION_DAYS; stale presence rows (24 h) and
# completed detection-test requests (7 days) are pruned automatically.
AUDIT_LOG_RETENTION_DAYS=365

# Records the DVR's own person/vehicle label in a separate table. Default off.
# No vision model is downloaded or run.
AI_ENABLED=false

# Development-only event fixtures. Ignored when NODE_ENV=production.
EVENT_DEV_MOCK=false

# Camera display names (server-side JSON) and the events database.
DATA_DIR=./data

# Optional extra hostnames allowed to open `npm run dev` (comma-separated).
# DEV_ALLOWED_ORIGINS=192.168.0.25

PORT=3000

# ---------------------------------------------------------------------------
# Playwright end-to-end QA (desktop only, 1920x1080, Chromium).
# Copy the QA_* block into a gitignored .env.qa, or export the variables.
# These are browser-test logins, not DVR credentials. Never commit real values.
# QA_ADMIN_* may be omitted locally: the suite falls back to APP_USERNAME /
# APP_PASSWORD. QA_VIEWER_* must be supplied explicitly; the VIEWER tests are
# skipped (never auto-created) when they are missing.
# ---------------------------------------------------------------------------
# QA_BASE_URL=http://localhost:3000
# QA_ADMIN_USERNAME=
# QA_ADMIN_PASSWORD=
# QA_VIEWER_USERNAME=
# QA_VIEWER_PASSWORD=



# ---------------------------------------------------------------------------
# Telegram notifications (optional). Server-side only: the bot token and chat id
# are read by the Next.js server and are never sent to the browser, returned by
# an API or written to a log. Leave them empty to keep Telegram off.
#
# TELEGRAM_EVENT_NOTIFICATIONS sends accepted camera events that a Notification
# Rule matched. Rule matching, priority, schedule, quiet hours, cooldown and
# duplicate protection are all decided before Telegram is called, and a Telegram
# failure never blocks the notification history.
#
# TELEGRAM_COOLDOWN_SECONDS is accepted for compatibility and is informational
# only; the notification rules remain the gate.
#
# Create a bot with @BotFather for the token, then message the bot and read the
# chat id from the getUpdates response. Never commit real values.
# ---------------------------------------------------------------------------
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_EVENT_NOTIFICATIONS=false
TELEGRAM_COOLDOWN_SECONDS=300

# A person/vehicle notification is media only: the event clip when it can be
# produced, otherwise the full camera snapshot. Both switches default to on, and
# no text message is sent for these notifications. The generic "Send Telegram
# Test" button stays text-only. Media is delivered by the durable background
# worker, never on the event-ingestion path. TELEGRAM_FACE_IMAGE is accepted as
# an older name for TELEGRAM_EVENT_IMAGE.
TELEGRAM_EVENT_IMAGE=true
TELEGRAM_FACE_VIDEO=true
# Clip length around the event timestamp: 5 + 5 = a 10 second clip by default.
# The clip is generated from the DVR's own recording track, never from the live
# WebRTC stream, and the H.265 recording is converted to H.264 MP4.
TELEGRAM_VIDEO_PRE_SECONDS=5
TELEGRAM_VIDEO_POST_SECONDS=5
# App-level cap for the clip upload. Telegram's own bot limit is 50 MB, so keep
# this below it. An oversized clip is re-encoded smaller once, then skipped.
TELEGRAM_VIDEO_MAX_MB=45
# How long FFmpeg may run for one clip before it is killed.
TELEGRAM_VIDEO_TIMEOUT_SECONDS=30
# FFmpeg is required for the clip. It is not bundled: install it on the host
# (macOS: brew install ffmpeg, Debian/Ubuntu: apt install ffmpeg) or use the
# container image, which already includes it. The snapshot still works when
# FFmpeg is missing; only the clip is skipped.
# FFMPEG_PATH=ffmpeg

# Timeline hover previews
# ---------------------------------------------------------------------------
# Frames are generated in the background into sprite sheets, so hovering a
# recording costs no DVR work at all. One worker by default: this DVR serves a
# single playback stream, so more would only contend.
PLAYBACK_THUMBNAIL_ENABLED=true
# Seconds between generated frames. 30 keeps a day at ~2150 frames per camera.
PLAYBACK_THUMBNAIL_INTERVAL_SECONDS=30
# Extraction concurrency. Values above 1 are clamped to 1 by the DVR's limit.
MAX_THUMBNAIL_WORKERS=1
# Days of generated sprites to keep. Recordings are never touched.
PLAYBACK_THUMBNAIL_RETENTION_DAYS=14
