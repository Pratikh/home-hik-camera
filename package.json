{
  "name": "home-cctv-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "face:model": "python3 face-worker/scripts/download_model.py",
    "face:worker": "python3 face-worker/worker.py",
    "face:worker:once": "python3 face-worker/worker.py --once",
    "test:face": "python3 -m pytest -q face-worker/tests",
    "mediamtx:config": "node scripts/render-mediamtx-config.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "hls.js": "^1.6.13",
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
