{
  "name": "home-cctv-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "face:model": "python3 face-worker/scripts/download_model.py",
    "face:worker": "python3 face-worker/worker.py",
    "face:worker:once": "python3 face-worker/worker.py --once",
    "test:face": "sh -c 'if [ -x .venv-face/bin/python ]; then .venv-face/bin/python -m pytest -q face-worker/tests; else python3 -m pytest -q face-worker/tests; fi'",
    "test:object": "sh -c 'if [ -x .venv-object/bin/python ]; then .venv-object/bin/python -m pytest -q object-worker/tests; else python3 -m pytest -q object-worker/tests; fi'",
    "object:model": "python3 object-worker/scripts/download_model.py",
    "object:worker": "python3 object-worker/worker.py",
    "mediamtx:config": "node --env-file=.env scripts/render-mediamtx-config.mjs",
    "mediamtx:up": "podman compose -f compose.yml -f compose.dev.yml up -d mediamtx",
    "stack:up": "podman compose up -d",
    "stack:down": "podman compose down",
    "backup": "sh scripts/backup.sh",
    "verify:backup": "sh scripts/verify-backup.sh",
    "cleanup:snapshots": "sh scripts/cleanup-orphan-snapshots.sh",
    "object:worker:local": "sh -c 'set -a; . ./.env; set +a; DATA_DIR=./data MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554 OBJECT_DETECTION_STREAM=rtsp .venv-object/bin/python object-worker/worker.py'"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "hls.js": "^1.7.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  }
}
